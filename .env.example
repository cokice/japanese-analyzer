# Japanese analyzer server API config

# Gemini
GEMINI_API_URL=
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=

# Optional login password
CODE=

# Allow anyone to use the server API keys when CODE is empty. Default: false.
# Only set true for personal or intranet use.
# ALLOW_PUBLIC_SERVER_KEY=false

# Session signing key, independent of CODE (e.g. `openssl rand -base64 32`).
# Random per process when unset; required for multi-instance deployments.
SESSION_SECRET=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional cookie transport override. Auto-detect HTTPS when unset.
# Set true behind an HTTPS reverse proxy; use false only for intentional HTTP deployments.
# AUTH_COOKIE_SECURE=true
