# Japanese analyzer server API config
# Copy this file to .env.local and fill in your keys.

# DeepSeek provider (default for text analysis)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Gemini provider (OCR, Gemini TTS, and alternative text model)
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Optional login password (leave empty to disable)
CODE=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Edge TTS server URL (defaults to public proxy)
# EDGE_TTS_URL=https://api.howen.ink/api/tts
