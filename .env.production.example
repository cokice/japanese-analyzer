# Japanese analyzer production server config
# Copy this file to .env.production and fill in your keys for Docker deployment.

# DeepSeek text provider
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Gemini provider, OCR and Gemini TTS
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Optional login password
CODE=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Edge TTS server URL (defaults to public proxy)
# EDGE_TTS_URL=https://api.howen.ink/api/tts
