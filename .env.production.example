# Japanese analyzer production server config
#
# 说明：解析/翻译/图片识别/单词详情/对话这些「用户请求」的模型端点与密钥
# 由浏览器「设置」里用户自己填写（保存在本地，随请求发送），服务器无需配置。
# 下面的服务器密钥只用于：首页「今日一句」的服务端自发请求，以及 Gemini 朗读。

# 首页「今日一句」专用端点（三者都填才生效，优先级最高）
# DAILY_SENTENCE_API_URL=
# DAILY_SENTENCE_API_KEY=
# DAILY_SENTENCE_API_MODEL=

# 未配置专用端点时，「今日一句」按顺序回退到 DeepSeek / Gemini
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL_NAME=

GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_NAME=

# Gemini 朗读（TTS）使用的密钥；用户未单独填写时回退到这里
# 不配置则 Gemini 朗读不可用

# 可选：允许「设置」里填写内网 / localhost 的模型地址（默认禁止，防止 SSRF）
# ALLOW_PRIVATE_BASE_URL=true

# Optional login password
CODE=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional cookie transport override. Auto-detect HTTPS when unset.
# Set true when TLS terminates at your reverse proxy.
# AUTH_COOKIE_SECURE=true
