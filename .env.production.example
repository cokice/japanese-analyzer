# Japanese analyzer production server config

# DeepSeek text provider and image OCR
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Gemini provider, optional OCR and Gemini TTS
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# The app does not rate-limit AI requests. For public deployments, set a usage or
# budget limit for the keys above in your AI provider's console.

# Optional login password
CODE=

# Allow anyone to use the server API keys when CODE is empty. Default: false.
# With CODE empty and this not set to true, requests without a personal API key
# are rejected. Only set true for personal or intranet deployments.
# ALLOW_PUBLIC_SERVER_KEY=false

# Session signing key, independent of CODE. Use a long random value,
# e.g. `openssl rand -base64 32`. When unset, a random key is generated at startup
# and users must sign in again after a restart.
# REQUIRED for multi-instance deployments (multiple replicas, Vercel or other
# serverless platforms): every instance must share the same value.
SESSION_SECRET=

# Optional Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional cookie transport override. Auto-detect HTTPS when unset.
# Set true when TLS terminates at your reverse proxy.
# AUTH_COOKIE_SECURE=true
