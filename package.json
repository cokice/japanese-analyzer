{
  "name": "japanese-analyzer",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/desktop/record-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx tests/api.test.ts && tsx tests/i18n.test.ts && tsx tests/regressions.test.ts && tsx tests/speech.test.ts && tsx tests/learning.test.ts && tsx tests/learningHooks.test.tsx && tsx tests/sentenceCache.test.tsx && tsx tests/sentenceVocabulary.test.tsx && node --test tests/dictionary-build.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop/dev.mjs",
    "desktop:package-server": "node scripts/desktop/package-server.mjs",
    "desktop:build": "node scripts/desktop/check-node.mjs && npm run build && npm run desktop:package-server && tauri build",
    "desktop:test": "node --test tests/desktop.test.mjs",
    "dictionary:prepare": "node scripts/dictionary/prepare.mjs",
    "dictionary:check": "node scripts/dictionary/update.mjs --check",
    "predev": "npm run dictionary:prepare",
    "prebuild": "npm run dictionary:check && npm run dictionary:prepare",
    "dictionary:smoke": "node scripts/dictionary/smoke.mjs"
  },
  "desktop": {
    "nodeVersion": "22.23.3"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.16",
    "@assistant-ui/react-streamdown": "^0.3.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@radix-ui/react-switch": "^1.3.0",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-virtual": "^3.14.9",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "flowtoken": "^1.0.40",
    "mdast-util-from-markdown": "^2.0.3",
    "motion": "^12.40.0",
    "next": "15.5.26",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-animate-height": "^3.2.4",
    "react-dom": "19.2.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
